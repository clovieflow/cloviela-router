# Required runtime settings.
# ---------------------------------------------------------------------------
# Database mode (the one choice that matters):
#   lite = embedded database, nothing to install (default — just run it).
#   full = external PostgreSQL via DATABASE_URL (VPS, share/selling, teams).
# Moving lite → full later is a JSON backup export + import, no rebuild.
# PORT                  — HTTP port the gateway/console listen on.
# CLOVIELA_BIND_HOST   — defaults to127.0.0.1; set0.0.0.0 explicitly inside containers.
# NODE_ENV              — development | production (affects logging/validation strictness).
# DASHBOARD_DIST        — built dashboard static directory served at /console.
# LOG_LEVEL             — pino level: debug / info / warn / error.
# DATABASE_URL          — required in full mode only; ignored in lite.
# CLOVIELA_ENCRYPTION_KEY
#                       — required 256-bit secret that encrypts provider credentials
#                         and API keys. Generate with one of the commands below.
# CLOVIELA_PUBLIC_ORIGIN
#                       — externally reachable URL for OAuth callbacks/links.
CLOVIELA_DB_MODE=lite
PORT=12800
CLOVIELA_BIND_HOST=127.0.0.1
NODE_ENV=development
DASHBOARD_DIST=./dist/dashboard
LOG_LEVEL=debug
# DATABASE_URL=postgres://postgres:replace-with-local-password@localhost:5432/cloviela
CLOVIELA_ENCRYPTION_KEY=replace-with-cloviela-encryption-key
CLOVIELA_PUBLIC_ORIGIN=http://localhost:12800

# How to generate CLOVIELA_ENCRYPTION_KEY (choose ONE; 32 bytes = 256 bits):
#   macOS / Linux:  openssl rand -hex 32
#   Windows (PowerShell):  [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
#   Bun / Node (any platform):  bun -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('base64'))"
# Paste the output as the key value. Either 64-char hex or base64 that decodes to 32 bytes is accepted.
# The setup/install helpers generate one automatically when the .env is created.

# Optional settings. Redis is never required: set REDIS_URL for shared
# coordination across instances, or leave it unset for the in-memory backend.
# REDIS_URL=redis://localhost:6379 # Shared Redis; omit for in-memory.
# CLOVIELA_DATA_DIR= # Writable state root; defaults per OS (lite DB lives in <dir>/pglite).
# TRUSTED_PROXY_CIDRS= # Trust forwarded client-IP headers from these proxy ranges.
# CLOVIELA_ALLOWED_NETWORKS= # Private CIDRs allowed for upstream connections.
# CLOVIELA_TELEMETRY_PAYLOAD_DIR=./data/telemetry-payloads # Payload capture directory.
# VITE_BACKEND_URL=http://127.0.0.1:12800 # Backend URL for dashboard development.

# Defaults and overrides. Uncomment only when the built-in default is not suitable.

# Database connection and lock limits.
# DATABASE_POOL_MAX=20 # Maximum database connections per process.
# DATABASE_STATEMENT_TIMEOUT_MS=30000 # Maximum statement runtime.
# DATABASE_IDLE_IN_TXN_TIMEOUT_MS=60000 # Maximum idle transaction time.
# DATABASE_LOCK_TIMEOUT_MS=5000 # Maximum lock wait time.

# Setup, request limits, memory warning, and graceful shutdown.
# CLOVIELA_SETUP_MODE=auto # Native checks by default; docker starts Compose Redis.
# CLOVIELA_SERVER_MAX_BODY_BYTES=8388608 # Maximum request body size.
# CLOVIELA_SERVER_IDLE_TIMEOUT=60 # Idle connection timeout in seconds.
# CLOVIELA_SHUTDOWN_DRAIN_WINDOW_MS=20000 # Time for active requests to finish.
# CLOVIELA_MEMORY_LIMIT_BYTES=536870912 # Explicit memory warning limit.

# Telemetry retention, payload limits, and provider installation identity.
# CLOVIELA_TELEMETRY_RETENTION_DAYS=30 # Metadata telemetry retention in days.
# CLOVIELA_TELEMETRY_PAYLOAD_MAX_BYTES=33554432 # Combined full-capture limit; 32 MiB.
# CLOVIELA_TELEMETRY_PAYLOAD_FILE_MAX_BYTES=268435456 # Backing file size limit.
# CLOVIELA_TELEMETRY_PAYLOAD_RETENTION_MS=900000 # Payload retention time.
# CLOVIELA_INSTALL_ID_DIR=./data/.cloviela # Writable installation-id directory.

# Network and abuse policy.
# CLOVIELA_ALLOW_PRIVATE_UPSTREAMS=true # Allow private upstream addresses.
# CLOVIELA_MAX_REDIRECTS=3 # Maximum upstream redirects.
# IP_RATE_MAX_PER_WINDOW=240 # Requests per client IP in the rate window.
# CLOVIELA_MODEL_STRIKE_THRESHOLD=10 # Invalid requests before an IP ban.
# CLOVIELA_MODEL_STRIKE_WINDOW_MS=300000 # Strike expiry time.
# CLOVIELA_MODEL_BAN_TTL_MS=3600000 # Invalid-model IP-ban duration.

# Upstream deadlines and fallback retry timing.
# CLOVIELA_UPSTREAM_TIMEOUT_MS=120000 # Overall upstream request deadline.
# CLOVIELA_STREAM_STALL_TIMEOUT_MS=360000 # Maximum stream silence.
# CLOVIELA_STREAM_FIRST_CHUNK_TIMEOUT_MS=200000 # Time to first visible chunk.
# CLOVIELA_FALLBACK_RETRY_BASE_MS=100 # Minimum fallback retry delay.
# CLOVIELA_FALLBACK_RETRY_CAP_MS=2000 # Maximum fallback retry delay.
# CLOVIELA_ROUTE_MAX_ATTEMPTS=8 # Per-request candidate dispatch attempt cap.

# Account and proxy-pool cooldowns and socket limits.
# CLOVIELA_ACCOUNT_RATE_LIMIT_COOLDOWN_MS=900000 # Rate-limit cooldown.
# CLOVIELA_ACCOUNT_QUOTA_COOLDOWN_MS=3600000 # Quota cooldown.
# CLOVIELA_ACCOUNT_MODEL_CAPACITY_COOLDOWN_MS=120000 # Model-capacity cooldown.
# CLOVIELA_ACCOUNT_TRANSIENT_COOLDOWN_MS=30000 # Temporary error cooldown.
# CLOVIELA_ACCOUNT_UNCLASSIFIED_COOLDOWN_MS=60000 # Unclassified error cooldown.
# CLOVIELA_POOL_COOLDOWN_MS=120000 # Proxy-pool failure cooldown.
# CLOVIELA_PROXY_MAX_SOCKETS=100 # Maximum active proxy sockets.
# CLOVIELA_PROXY_MAX_FREE_SOCKETS=20 # Maximum idle proxy sockets.

# Provider-specific overrides. Leave unset unless a different endpoint is required.
# CLOVIELA_KIMI_OAUTH_HOST= # Kimi OAuth host override.
# CLOVIELA_KIMI_QUOTA_BASE_URL= # Kimi quota API base URL override.
# CLOVIELA_GITHUB_ENTERPRISE_DOMAIN= # Enterprise domain; empty uses github.com.

# Test database (isolated from development data; used by `bun run test`).
# CLOVIELA_TEST_DATABASE_URL=postgres://cloviela_test:cloviela_test@127.0.0.1:55432/cloviela_test
# CLOVIELA_TEST_REDIS_URL=redis://127.0.0.1:6379
